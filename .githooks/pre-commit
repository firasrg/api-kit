#!/bin/sh
set -e
cd "$(git rev-parse --show-toplevel)"

# Skip when no Java files are staged.
git diff --cached --name-only --diff-filter=ACM | grep -q '\.java$' || exit 0

echo "pre-commit: checking formatting (Spotless)..."
if ! ./mvnw -q --batch-mode spotless:check; then
  echo "Formatting violations. Run './mvnw spotless:apply', re-stage, and commit again." >&2
  exit 1
fi