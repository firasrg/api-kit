#!/bin/sh
if branch=$(git symbolic-ref --short -q HEAD); then
  sh "$(dirname "$0")/branch-name-check" "$branch" || exit 1
fi

set -e
cd "$(git rev-parse --show-toplevel)"

git diff --cached --name-only --diff-filter=ACM | grep -q '\.java$' || exit 0

echo "pre-commit: Spotless + Checkstyle..."
if ! ./mvnw -q --batch-mode spotless:check checkstyle:check; then
  echo "Run './mvnw spotless:apply', fix Checkstyle issues, re-stage, and commit again." >&2
  exit 1
fi